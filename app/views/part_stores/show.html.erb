<div class="flex min-w-0 items-center justify-between gap-4">
  <div class="min-w-0">
    <h1 class="break-words text-3xl font-bold">Part Store <%= @part_store.name %></h1>
  </div>
  <div class="flex flex-row">
    <%= render layout: "shared/modal", locals: { title: "Upload your data", trigger: link_to("Upload your data", new_datasheet_path(part_store_id: @part_store.id), class: "bg-orange-400 hover:bg-orange-500 cursor-pointer text-white px-4 py-2 rounded-full", data: { turbo_frame: "datasheet_form", action: "modal#open" }) } do %>
      <%= turbo_frame_tag "datasheet_form" %>
    <% end %>
  </div>
</div>
<p class="text-gray-500 mt-3">Here you can see your parts catalog</p>
<div class="mt-13 flex min-w-0 flex-col gap-4">
  <%= render partial: "datasheets/datasheet", collection: @datasheets %>
</div>
