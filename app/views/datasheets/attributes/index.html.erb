<%= turbo_frame_tag "attributes_#{@datasheet.id}", class: "block w-full min-w-0 overflow-x-auto" do %>
  <table class="w-max min-w-full whitespace-nowrap border-collapse">
    <thead class="border-b border-gray-300">
      <tr>
        <th class="p-2 text-left">Reference</th>
        <th class="p-2 text-left">Brand</th>
        <th class="p-2 text-left">Product</th>
        <th class="p-2 text-left">Class</th>
        <th class="p-2 text-left">Attribute</th>
        <th class="p-2 text-left">Unit</th>
        <th class="p-2 text-left">Value</th>
      </tr>
    </thead>
    <tbody>
      <% @view.attributes.each do |row| %>
        <tr class="border-b border-gray-300 odd:bg-gray-100">
          <td class="p-2 text-left"><%= row.reference %></td>
          <td class="p-2 text-left"><%= row.brand %></td>
          <td class="p-2 text-left"><%= row.product %></td>
          <td class="p-2 text-left"><%= row.attribute_class %></td>
          <td class="p-2 text-left"><%= row.name %></td>
          <td class="p-2 text-left"><%= row.unit %></td>
          <td class="p-2 text-left"><%= row.value %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
