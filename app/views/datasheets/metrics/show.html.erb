<%= turbo_frame_tag "metrics_#{@datasheet.id}", class: "block w-full min-w-0" do %>
  <h2 class="p-2 text-lg font-semibold">Catálogo Bonaparte - <%= @datasheet.part_store.name %></h2>
  <dl class="p-2">
    <div class="grid grid-cols-2 gap-2 border-b border-gray-300 py-2">
      <dt>Referencias</dt>
      <dd><%= @metrics.references %></dd>
    </div>
    <div class="py-2 font-semibold">Aplicaciones</div>
    <div class="grid grid-cols-2 gap-2 py-1">
      <dt>Origen</dt>
      <dd>0</dd>
    </div>
    <div class="grid grid-cols-2 gap-2 border-b border-gray-300 py-1">
      <dt>Incrementos</dt>
      <dd><%= @metrics.applications %></dd>
    </div>
    <div class="py-2 font-semibold">Intercambios</div>
    <div class="grid grid-cols-2 gap-2 py-1">
      <dt>Origen</dt>
      <dd>0</dd>
    </div>
    <div class="grid grid-cols-2 gap-2 border-b border-gray-300 py-1">
      <dt>Incrementos</dt>
      <dd><%= @metrics.interchanges %></dd>
    </div>
    <div class="py-2 font-semibold">Atributos</div>
    <div class="grid grid-cols-2 gap-2 py-1">
      <dt>Origen</dt>
      <dd>0</dd>
    </div>
    <div class="grid grid-cols-2 gap-2 border-b border-gray-300 py-1">
      <dt>Incrementos</dt>
      <dd><%= @metrics.attributes %></dd>
    </div>
    <div class="grid grid-cols-2 gap-2 py-2">
      <dt>Sin ficha</dt>
      <dd><%= @metrics.without_sheet %></dd>
    </div>
  </dl>
<% end %>
