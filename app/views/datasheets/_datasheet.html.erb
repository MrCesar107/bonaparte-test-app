<div class="flex min-w-0 flex-col">
  <div class="flex flex-row justify-between items-center p-4 border-t border-x rounded-t-lg border-gray-300">
    <div class="flex flex-col">
      <%= datasheet.name %>
    </div>
    <% if datasheet.created? %>
      <div class="flex flex-row items-center gap-2">
        <i class="fa-solid fa-chevron-right"></i>
      </div>
    <% end %>
  </div>
  <div class="w-full min-w-0 border-b border-x rounded-b-lg border-gray-300 p-4">
    <div data-controller="tabs" data-tabs-active-tab-class="-mb-px border-l border-t border-r rounded-t border-gray-300">
      <ul class="list-reset flex border-b border-gray-300">
        <li class="-mb-px mr-1" data-tabs-target="tab" data-action="click->tabs#change:prevent">
          <a class="bg-white inline-block py-2 px-4 text-orange-400 hover:text-orange-500 font-semibold no-underline" href="#">Origen</a>
        </li>
        <li class="mr-1" data-tabs-target="tab" data-action="click->tabs#change:prevent">
          <a class="bg-white inline-block py-2 px-4 text-orange-400 hover:text-orange-500 font-semibold no-underline" href="#">Métricas</a>
        </li>
        <li class="mr-1" data-tabs-target="tab" data-action="click->tabs#change:prevent">
          <a class="bg-white inline-block py-2 px-4 text-orange-400 hover:text-orange-500 font-semibold no-underline" href="#">Aplicaciones</a>
        </li>
        <li class="mr-1" data-tabs-target="tab" data-action="click->tabs#change:prevent">
          <a class="bg-white inline-block py-2 px-4 text-orange-400 hover:text-orange-500 font-semibold no-underline" href="#">Intercambios</a>
        </li>
        <li class="mr-1" data-tabs-target="tab" data-action="click->tabs#change:prevent">
          <a class="bg-white inline-block py-2 px-4 text-orange-400 hover:text-orange-500 font-semibold no-underline" href="#">Atributos</a>
        </li>
        <li class="mr-1" data-tabs-target="tab" data-action="click->tabs#change:prevent">
          <a class="bg-white inline-block py-2 px-4 text-orange-400 hover:text-orange-500 font-semibold no-underline" href="#">Catálogo</a>
        </li>
      </ul>
      <div class="hidden p-4 border-l border-b border-r border-gray-300" data-tabs-target="panel">
        <%= turbo_frame_tag "source_rows_#{datasheet.id}", src: datasheet_source_rows_path(datasheet), class: "block w-full min-w-0 overflow-x-auto" %>
      </div>
      <div class="hidden p-4 border-l border-b border-r border-gray-300" data-tabs-target="panel">
        <%= turbo_frame_tag "metrics_#{datasheet.id}", src: datasheet_metrics_path(datasheet), class: "block w-full min-w-0 overflow-x-auto" %>
      </div>
      <div class="hidden p-4 border-l border-b border-r border-gray-300" data-tabs-target="panel">
        <%= turbo_frame_tag "applications_#{datasheet.id}", src: datasheet_applications_path(datasheet), class: "block w-full min-w-0 overflow-x-auto" %>
      </div>
      <div class="hidden p-4 border-l border-b border-r border-gray-300" data-tabs-target="panel">
        <%= turbo_frame_tag "interchanges_#{datasheet.id}", src: datasheet_interchanges_path(datasheet), class: "block w-full min-w-0 overflow-x-auto" %>
      </div>
    </div>
  </div>
</div>
