<%= turbo_frame_tag dom_id(datasheet), class: "block min-w-0" do %>
  <% if datasheet.pending? %>
    <div
      class="flex min-w-0 flex-row items-center justify-between gap-4 rounded-lg border border-gray-300 p-4"
      role="status"
      data-controller="datasheet-status"
      data-datasheet-status-url-value="<%= datasheet_path(datasheet) %>"
      data-datasheet-status-interval-value="2000"
    >
      <div class="flex min-w-0 flex-col">
        <%= datasheet.name %>
      </div>
      <div class="flex shrink-0 flex-row items-center gap-2 text-sm text-gray-500">
        <i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i>
        <span>Generating</span>
      </div>
    </div>
  <% elsif datasheet.created? %>
    <div class="group flex min-w-0 flex-col" data-controller="datasheet-card" data-open="false">
      <div class="flex min-w-0 flex-row items-center justify-between gap-4 rounded-lg border border-gray-300 p-4 group-data-[open=true]:rounded-b-none">
        <div class="flex min-w-0 flex-col">
          <%= datasheet.name %>
        </div>
        <button
          type="button"
          class="flex size-8 shrink-0 cursor-pointer items-center justify-center text-gray-500 hover:text-gray-800"
          data-action="datasheet-card#toggle"
          data-datasheet-card-target="trigger"
          aria-expanded="false"
          aria-controls="<%= dom_id(datasheet, :sections) %>"
          aria-label="Mostrar secciones"
        >
          <i class="fa-solid fa-chevron-right transition-transform duration-300 ease-in-out motion-reduce:transition-none group-data-[open=true]:rotate-90" aria-hidden="true"></i>
        </button>
      </div>
      <div id="<%= dom_id(datasheet, :sections) %>" class="h-0 min-w-0 overflow-hidden transition-[height] duration-300 ease-in-out motion-reduce:transition-none" data-datasheet-card-target="panel">
        <div class="min-w-0">
          <div class="w-full min-w-0 rounded-b-lg border-x border-b border-gray-300 p-4">
            <div data-controller="tabs" data-tabs-active-tab-class="-mb-px border-l border-t border-r rounded-t border-gray-300">
              <ul class="list-reset flex border-b border-gray-300">
                <li class="-mb-px mr-1" data-tabs-target="tab" data-action="click->tabs#change:prevent">
                  <a class="bg-white inline-block py-2 px-4 text-orange-400 hover:text-orange-500 font-semibold no-underline" href="#">Origen</a>
                </li>
                <li class="mr-1" data-tabs-target="tab" data-action="click->tabs#change:prevent">
                  <a class="bg-white inline-block py-2 px-4 text-orange-400 hover:text-orange-500 font-semibold no-underline" href="#">Métricas</a>
                </li>
                <li class="mr-1" data-tabs-target="tab" data-action="click->tabs#change:prevent">
                  <a class="bg-white inline-block py-2 px-4 text-orange-400 hover:text-orange-500 font-semibold no-underline" href="#">Aplicaciones</a>
                </li>
                <li class="mr-1" data-tabs-target="tab" data-action="click->tabs#change:prevent">
                  <a class="bg-white inline-block py-2 px-4 text-orange-400 hover:text-orange-500 font-semibold no-underline" href="#">Intercambios</a>
                </li>
                <li class="mr-1" data-tabs-target="tab" data-action="click->tabs#change:prevent">
                  <a class="bg-white inline-block py-2 px-4 text-orange-400 hover:text-orange-500 font-semibold no-underline" href="#">Atributos</a>
                </li>
                <li class="mr-1" data-tabs-target="tab" data-action="click->tabs#change:prevent">
                  <a class="bg-white inline-block py-2 px-4 text-orange-400 hover:text-orange-500 font-semibold no-underline" href="#">Catálogo</a>
                </li>
              </ul>
              <div class="hidden p-4 border-l border-b border-r border-gray-300" data-tabs-target="panel">
                <%= turbo_frame_tag "source_rows_#{datasheet.id}", src: datasheet_source_rows_path(datasheet), class: "block w-full min-w-0 overflow-x-auto" %>
              </div>
              <div class="hidden p-4 border-l border-b border-r border-gray-300" data-tabs-target="panel">
                <%= turbo_frame_tag "metrics_#{datasheet.id}", src: datasheet_metrics_path(datasheet), class: "block w-full min-w-0 overflow-x-auto" %>
              </div>
              <div class="hidden p-4 border-l border-b border-r border-gray-300" data-tabs-target="panel">
                <%= turbo_frame_tag "applications_#{datasheet.id}", src: datasheet_applications_path(datasheet), class: "block w-full min-w-0 overflow-x-auto" %>
              </div>
              <div class="hidden p-4 border-l border-b border-r border-gray-300" data-tabs-target="panel">
                <%= turbo_frame_tag "interchanges_#{datasheet.id}", src: datasheet_interchanges_path(datasheet), class: "block w-full min-w-0 overflow-x-auto" %>
              </div>
              <div class="hidden p-4 border-l border-b border-r border-gray-300" data-tabs-target="panel">
                <%= turbo_frame_tag "attributes_#{datasheet.id}", src: datasheet_attributes_path(datasheet), class: "block w-full min-w-0 overflow-x-auto" %>
              </div>
              <div class="hidden p-4 border-l border-b border-r border-gray-300" data-tabs-target="panel">
                <%= turbo_frame_tag "catalog_rows_#{datasheet.id}", src: datasheet_catalog_rows_path(datasheet), class: "block w-full min-w-0 overflow-x-auto" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="flex min-w-0 flex-row items-center justify-between gap-4 rounded-lg border border-gray-300 p-4">
      <div class="flex min-w-0 flex-col">
        <%= datasheet.name %>
      </div>
      <span class="shrink-0 text-sm text-red-600">
        <%= datasheet.failed? ? "No se pudo procesar" : "Sin resultados" %>
      </span>
    </div>
  <% end %>
<% end %>
