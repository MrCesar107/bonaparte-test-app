<%= turbo_frame_tag "interchanges_#{@datasheet.id}", class: "block w-full min-w-0 overflow-x-auto" do %>
  <table class="w-max min-w-full whitespace-nowrap border-collapse">
    <thead class="border-b border-gray-300">
      <tr>
        <th class="p-2 text-left">Reference</th>
        <th class="p-2 text-left">Brand</th>
        <th class="p-2 text-left">Product</th>
        <th class="p-2 text-left">Interchange</th>
        <th class="p-2 text-left">Interchange Brand</th>
        <th class="p-2 text-left">Origin</th>
      </tr>
    </thead>
    <tbody>
      <% @rows.each do |row| %>
        <tr class="border-b border-gray-300 odd:bg-gray-100">
          <td class="p-2 text-left"><%= row.reference %></td>
          <td class="p-2 text-left"><%= row.brand %></td>
          <td class="p-2 text-left"><%= row.product %></td>
          <td class="p-2 text-left"><%= row.number %></td>
          <td class="p-2 text-left"><%= row.interchange_brand %></td>
          <td class="p-2 text-left"><%= row.origin %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
