  <div class="container mx-auto px-5 py-4 flex justify-between items-center">
    <div>
      <%= link_to root_path do %>
        <%= image_tag "logo.svg", alt: "Bonaparte", class: "w-auto h-8" %>
      <% end %>
    </div>
    <div>
