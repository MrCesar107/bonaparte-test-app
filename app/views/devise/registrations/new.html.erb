<div class="flex flex-1 justify-center px-6 py-20 sm:py-32">
  <div class="flex w-full max-w-md flex-col gap-8 bg-slate-100 p-4 rounded-lg border-2 border-slate-200 shadow-md">
    <div class="my-auto w-full">
      <h1 class="text-2xl font-bold text-center mb-3">Sign up</h1>
      <p class="text-center text-slate-500 mb-10">Create an account to get started</p>
      <div class="w-full">
        <%= simple_form_for resource, as: resource_name, url: registration_path(resource_name), html: { class: "flex flex-col gap-8" } do |f| %>
          <%= f.error_notification %>
          <%= f.input :first_name, required: true, placeholder: "Enter your name", label: "Name", wrapper_html: { class: "flex flex-col gap-1.5" }, input_html: { class: "w-full p-2 rounded-md border-2 border-slate-300 bg-white" } %>
          <%= f.input :last_name, required: true, placeholder: "Enter your last name", label: "Last name", wrapper_html: { class: "flex flex-col gap-1.5" }, input_html: { class: "w-full p-2 rounded-md border-2 border-slate-300 bg-white" } %>
          <%= f.input :email, required: true, autofocus: true, placeholder: "Enter your email", label: "Email", wrapper_html: { class: "flex flex-col gap-1.5" }, input_html: { class: "w-full p-2 rounded-md border-2 border-slate-300 bg-white" } %>
          <div class="flex flex-col gap-1.5">
            <div class="flex items-center gap-1.5">
              <%= f.label :password, class: "password required" do %>
                <abbr title="required">*</abbr> Password
              <% end %>
              <% if @minimum_password_length %>
                <%= render "shared/hint", text: "#{@minimum_password_length} characters minimum", label: "Password requirements" %>
              <% end %>
            </div>
            <%= f.input :password, required: true, placeholder: "Enter your password", label: false, hint: false, input_html: { class: "w-full p-2 rounded-md border-2 border-slate-300 bg-white" } %>
          </div>
          <%= f.input :password_confirmation, required: true, placeholder: "Confirm your password", label: "Password confirmation", wrapper_html: { class: "flex flex-col gap-1.5" }, input_html: { class: "w-full p-2 rounded-md border-2 border-slate-300 bg-white" } %>
          <%= f.button :submit, "Sign up", class: "w-full bg-orange-400 hover:bg-orange-500 cursor-pointer rounded-full text-white p-2" %>
        <% end %>
        <div class="mt-6 flex flex-col items-center gap-2 text-sm text-slate-500 [&_a]:text-orange-400 [&_a]:hover:text-orange-500">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
  </div>
</div>
