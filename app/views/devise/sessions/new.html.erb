<div class="flex flex-1 items-center justify-center px-6 py-20 sm:py-32">
  <div class="flex h-fit w-full max-w-md flex-col gap-8 bg-slate-100 p-4 rounded-lg border-2 border-slate-200 shadow-md">
    <div class="w-full">
      <h1 class="text-2xl font-bold text-center mb-3">Log in</h1>
      <p class="text-center text-slate-500 mb-10">Sign in to your account</p>
      <div class="w-full">
        <% invalid_field_classes = "[&.invalid_label]:font-medium [&.invalid_label]:text-red-600 [&.invalid_input]:border-red-600" %>
        <%= simple_form_for resource, as: resource_name, url: session_path(resource_name), html: { class: "flex flex-col gap-8" }, defaults: { error_html: { class: "block text-sm text-red-600" }, wrapper_error_class: "field_with_errors invalid" } do |f| %>
          <%= f.error_notification class: "rounded-md bg-red-50 px-3 py-2 text-sm text-red-600" %>
          <%= f.input :email, required: true, autofocus: true, placeholder: "Enter your email", label: "Email", wrapper_html: { class: "flex flex-col gap-1.5 #{invalid_field_classes}" }, input_html: { class: "w-full p-2 rounded-md border-2 border-slate-300 bg-white" } %>
          <%= f.input :password, required: true, placeholder: "Enter your password", label: "Password", wrapper_html: { class: "flex flex-col gap-1.5 #{invalid_field_classes}" }, input_html: { class: "w-full p-2 rounded-md border-2 border-slate-300 bg-white" } %>
          <% if devise_mapping.rememberable? %>
            <%= f.input :remember_me, as: :boolean, wrapper_html: { class: "flex" }, label_html: { class: "flex items-center gap-2" } %>
          <% end %>
          <%= f.button :submit, "Log in", class: "w-full bg-orange-400 hover:bg-orange-500 cursor-pointer rounded-full text-white p-2" %>
        <% end %>
        <div class="mt-6 flex flex-col items-center gap-2 text-sm text-slate-500 [&_a]:text-orange-400 [&_a]:hover:text-orange-500">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
  </div>
</div>
